{
  "appId": "com.ganeshpr.retrochat",
  "appName": "Retro Chat",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#09090b",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "AdMob": {
      "appId": "ca-app-pub-9957821482976268~1234567890"
    }
  }
}
